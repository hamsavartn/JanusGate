{
  "name": "JanusGate — guard every LLM step",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{}]
        }
      },
      "id": "a1",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8123/inspect",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": {{ JSON.stringify($json.textToCheck || \"Replace me: wire the text you want guarded\") }},\n  \"source\": \"tool_output\"\n}"
      },
      "id": "a2",
      "name": "JanusGate inspect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.is_attack }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "a3",
      "name": "Attack detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [320, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.is_attack }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "false", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "a4",
      "name": "Clean — continue workflow",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [320, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sentinel-webhook",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a5",
      "name": "Webhook: text to check",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-440, 0],
      "webhookId": "janusgate-demo"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8123/email/quarantine",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message_id\": {{ JSON.stringify($('Webhook: text to check').item.json.body.message_id || \"msg_flagged\") }},\n  \"reason\": {{ JSON.stringify($json.attack_class + \" - Risk: \" + $json.final_risk) }},\n  \"sender\": {{ JSON.stringify($('Webhook: text to check').item.json.body.sender || null) }},\n  \"subject\": {{ JSON.stringify($('Webhook: text to check').item.json.body.subject || null) }}\n}"
      },
      "id": "a6",
      "name": "Quarantine Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, -40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8123/summarize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": {{ JSON.stringify($('Webhook: text to check').item.json.body.text || \"Email text missing\") }}\n}"
      },
      "id": "a7",
      "name": "Summarize with JanusGuard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 200]
    }
  ],
  "connections": {
    "Webhook: text to check": {
      "main": [[{ "node": "JanusGate inspect", "type": "main", "index": 0 }]]
    },
    "Every 5 minutes": {
      "main": [[{ "node": "JanusGate inspect", "type": "main", "index": 0 }]]
    },
    "JanusGate inspect": {
      "main": [
        [
          { "node": "Attack detected?", "type": "main", "index": 0 },
          { "node": "Clean — continue workflow", "type": "main", "index": 0 }
        ]
      ]
    },
    "Attack detected?": {
      "main": [
        [{ "node": "Quarantine Email", "type": "main", "index": 0 }]
      ]
    },
    "Clean — continue workflow": {
      "main": [
        [{ "node": "Summarize with JanusGuard", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "description": "ForgeHacks 2026 — JanusGate (AI + Cybersecurity). Import into n8n (Workflows → Import from file), then wire your own trigger and actions. Attack paths stop here; clean paths continue. Replace localhost with your deployed Sentinel URL."
  },
  "tags": ["janusgate", "security", "forgehacks"]
}
