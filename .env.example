# Copy this file to .env and fill in your real keys.
# .env is gitignored — it will NEVER be committed.

# Primary LLM (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_JUDGE_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Secondary LLM (ForgeHacks sponsor credit) — optional, used as fallback ensemble member
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Backend
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8123
